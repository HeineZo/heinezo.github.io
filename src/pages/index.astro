---
import '@/styles/globals.css';
import Layout from '@/layouts/Layout.astro';
import Hero from '@/layouts/Hero.astro';
import Projets from '@/layouts/Projects.astro';
import Skills from '@/layouts/Skills.astro';
import { defaultLocale } from '@/i18n/config';

const locale = defaultLocale;
---

<Layout title='Enzo Morvan' locale={locale}>
	<Hero locale={locale} />
	<Projets locale={locale} />
	<Skills locale={locale} />
</Layout>

<script is:inline>
	if (window.history && window.history.replaceState && window.location.pathname === '/') {
		window.history.replaceState(null, '', '/fr/');
	}

	(function() {
		setTimeout(function() {
			const cookie = document.cookie;
			const localeMatch = cookie.match(/preferred-locale=([^;]+)/);
			if (localeMatch && localeMatch[1] === 'en') {
				window.location.replace('/en/');
				return;
			}

			if (typeof localStorage !== 'undefined') {
				const savedLocale = localStorage.getItem('preferred-locale');
				if (savedLocale === 'en') {
					window.location.replace('/en/');
				}
			}
		}, 0);
	})();
</script>
