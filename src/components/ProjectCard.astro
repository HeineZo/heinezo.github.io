---
import { cn } from '@/lib/utils';
import { Image } from 'astro:assets';
import BrandIcon from './ui/BrandIcon';
import { Button } from './ui/button';
import type { Locale } from '@/i18n/config';
import { t } from '@/i18n/utils';

const { title, description, img, link, languages, className, locale } = Astro.props;

const images:{[index:string]:any} ={}
await Astro.glob("/src/assets/*.png").then((files) => {
    files.forEach((file) => {
        const name = file.default.src.split(".")[0].split("/").pop()
        images[name]=file.default
    });
});

const image = images[img];
---

<div class={cn('flex gap-8 w-full flex-col lg:flex-row', className)} >
	<Image
		src={image}
		alt='Couverture du projet'
		width={500}
		height={300}
		loading='eager'
		class='rounded-xl aspect-video max-w-md w-full object-cover object-top shadow'
	/>
	<div class='flex flex-col justify-between gap-4'>
		<div class='flex flex-col gap-2'>
			<h3>{title}</h3>
			<span class='flex gap-2 rounded-xl w-fit '>
				{
					languages.map((lang: string) => (
						<BrandIcon name={lang} client:only />
					))
				}
			</span>
			<p class='text-muted-foreground'>
				{description}
			</p>
		</div>
		<a href={link} class='w-fit'>
			<Button variant='secondary'>{t(locale, 'projects.view')}</Button>
		</a>
	</div>
</div>
