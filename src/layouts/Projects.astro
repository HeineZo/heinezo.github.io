---
import ProjectCard from '@/components/ProjectCard.astro';
import Reveal from '@/components/Reveal';
import { TracingBeam } from '@/components/TracingBeam';
import { Button } from '@/components/ui/button';
import { t } from '@/i18n/utils';
import type { Locale } from '@/i18n/config';

interface Props {
	locale: Locale;
}

const { locale } = Astro.props;

// Charger les projets selon la locale
let projectsData;
if (locale === 'en') {
	projectsData = await import('@/i18n/data/projects.en.json');
} else {
	projectsData = await import('@/i18n/data/projects.fr.json');
}
const projects = projectsData.default.slice(0, -1);
const lastProject = projectsData.default.slice(-1)[0];

const reposData = await fetch('https://api.github.com/users/HeineZo/repos');
const repos = await reposData.json();
const nbProjects = repos.length - projects.length;
---

<div id='projects' class='w-full flex flex-col items-start gap-8'>
	<h2>{t(locale, 'projects.title')}</h2>
	<TracingBeam client:load>
		<div class='flex flex-col gap-16 w-full max-w-5xl'>
			{
				projects.map((project) => (
					<Reveal client:load>
						<ProjectCard
							title={project.title}
							description={project.description}
							img={project.img}
							link={project.link}
							languages={project.languages}
						/>
					</Reveal>
				))
			}
			<div class='relative'>
				<div
					class='flex flex-col absolute w-full h-full p-8 backdrop-blur-md justify-center gap-4 bg-white dark:bg-black bg-opacity-30 dark:bg-opacity-30'>
					<h3>
						{t(locale, 'projects.remaining')} <span
							class='bg-gradient-to-r from-foreground to-orange-400 text-transparent bg-clip-text'
							>{isNaN(nbProjects) ? t(locale, 'projects.many') : nbProjects} {t(locale, 'projects.projectsToDiscover')}</span
						>
					</h3>
					<a
						href='https://github.com/HeineZo?tab=repositories'
						class='w-fit'>
						<Button> {t(locale, 'projects.discover')} </Button>
					</a>
				</div>
				<div class='p-8'>
					<ProjectCard
						title={lastProject.title}
						description={lastProject.description}
						img={lastProject.img}
						link={lastProject.link}
						languages={lastProject.languages}
					/>
				</div>
			</div>
		</div>
	</TracingBeam>
</div>
