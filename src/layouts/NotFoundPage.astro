---
import '@/styles/globals.css';
import Layout from '@/layouts/Layout.astro';
import { Empty, EmptyHeader, EmptyTitle, EmptyDescription, EmptyContent, EmptyMedia } from '@/components/ui/empty';
import { Button } from '@/components/ui/button';
import { t } from '@/i18n/utils';
import { Image } from 'astro:assets';
import type { Locale } from '@/i18n/config';

interface Props {
	locale: Locale;
}

const { locale } = Astro.props;
const homeHref = locale === 'fr' ? '/fr/' : '/';
---

<Layout locale={locale}>
	<div class='w-full flex items-center justify-center py-32 min-h-[60vh]'>
		<Empty client:load>
			<EmptyHeader>
				<EmptyMedia variant="default">
					<Image
						src="/src/assets/404.png"
						alt="404"
						width={300}
						height={300}
					/>
				</EmptyMedia>
				<EmptyTitle className='text-2xl font-bold'>{t(locale, '404.title')}</EmptyTitle>
				<EmptyDescription className='text-lg'>{t(locale, '404.description')}</EmptyDescription>
			</EmptyHeader>
			<EmptyContent>
				<a href={homeHref}>
					<Button variant="default">{t(locale, '404.backHome')}</Button>
				</a>
			</EmptyContent>
		</Empty>
	</div>
</Layout>

