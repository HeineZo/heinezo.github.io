---
import CurvedLinks from '@/components/CurvedLinks.astro';
import { Button } from '@/components/ui/Button';
import { Link } from '@/components/ui/Link';
import { Circle } from '@/icons/Circle';
import { MoveDown } from 'lucide-react';
---

<div class="md:h-[80dvh] flex flex-col items-center justify-between">
	<div class='center gap-8 md:mt-24'>
		<div class='max-w-xl center gap-2'>
			<h1 class='w-fit'>
				<div class='relative inline-block'>
					<span class="absolute grid place-content-center top-0 -left-3 h-full w-full">
						<Circle
							size={150}
							className="*:stroke-orange-500"
							client:load
						/>
					</span>
					Enzo,
				</div>
				{new Date().getFullYear() - new Date('2003-08-13').getFullYear()} ans, apprenti ingénieur logiciel
			</h1>
			<p>
				Passionné par les architectures et le code propre, je passe mon
				temps libre à construire des projets personnels qui me poussent à
				aller plus loin dans ma réflexion et mes compétences
			</p>
		</div>
		<CurvedLinks />
		<div class='center gap-2'>
			<span class='px-4 py-2 rounded-full border border-foreground'>
				Actuellement
			</span>
			<span>
				Étudiant ingénieur logiciel en alternance chez 
					<Link href='https://www.abtasty.com/'>
						AB Tasty
					</Link>
				</Button>
			</span>
		</div>
	</div>
	<MoveDown className='animate-bounce hidden md:block' />
</div>
