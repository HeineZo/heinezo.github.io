---
import ThemeToggle from '@/components/ui/ThemeToggle';
import { LanguageToggle } from '@/components/LanguageToggle';
import type { Locale } from '@/i18n/config';

interface Props {
	locale: Locale;
}

const { locale } = Astro.props;
const currentPath = Astro.url.pathname;
---

<nav
	class='flex justify-center w-full backdrop-blur-3xl bg-opacity-50 border-b px-8 py-4 sticky top-0 z-50'
	transition:persist>
	<div class='flex justify-between items-center max-w-7xl w-full'>
		<h3>Enzo.</h3>
		<!-- <div class='flex gap-2'>
			{
				sections.map((section) => (
					<a href={section.url}>
						<Button variant='ghost'>{section.name}</Button>
					</a>
				))
			}
		</div> -->
		<div class='flex gap-2'>
			<LanguageToggle currentLocale={locale} currentPath={currentPath} client:load />
			<ThemeToggle client:load />
		</div>
	</div>
</nav>