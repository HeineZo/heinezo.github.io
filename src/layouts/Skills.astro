---
import { BentoGrid, BentoGridItem } from "@/components/BentoGrid";
import { t } from '@/i18n/utils';
import type { Locale } from '@/i18n/config';

interface Props {
	locale: Locale;
}

const { locale } = Astro.props;
let items;
if (locale === 'en') {
	items = await import('@/i18n/data/skills.en.json');
} else {
	items = await import('@/i18n/data/skills.fr.json');
}
---

<div id='skills' class="w-full flex flex-col items-start gap-8">
	<h2>{t(locale, 'skills.title')}</h2>
	<BentoGrid>
		{
			items.default.map((item, i) => (
				<BentoGridItem
					title={item.title}
					description={item.description}
					color={item.color}	
					icon={item.icon}
					className={i === 3 || i === 6 ? 'md:col-span-2' : ''}
				/>
			))
		}
	</BentoGrid>
</div>
