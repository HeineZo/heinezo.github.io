---
import Navbar from '@/layouts/Navbar.astro';
import Footer from './Footer.astro';
import { t } from '@/i18n/utils';
import type { Locale } from '@/i18n/config';

interface Props {
	locale: Locale;
}

const { locale } = Astro.props;
const lang = locale === 'en' ? 'en' : 'fr';
---

<!doctype html>
<html lang={lang}>
	<head>
		<title>{t(locale, 'meta.title')}</title>
		<meta charset='UTF-8' />
		<meta name='viewport' content='width=device-width' />
		<meta name="description" content={t(locale, 'meta.description')}>
		<meta name="keywords" content={t(locale, 'meta.keywords')}>
		<meta name="author" content="Enzo Morvan">
		<meta property="og:title" content={t(locale, 'meta.ogTitle')}>
		<meta property="og:description" content={t(locale, 'meta.ogDescription')}>
		<meta property="og:type" content="website">
		<meta property="og:url" content={`https://heinezo.github.io${Astro.url.pathname}`}>
		<meta property="og:image" content="/preview.jpg">
		<meta name="twitter:card" content="summary">
		<meta name="twitter:title" content={t(locale, 'meta.ogTitle')}>
		<meta name="twitter:description" content={t(locale, 'meta.ogDescription')}>
		<meta name="twitter:image" content="/preview.jpg">
		<meta name='generator' content={Astro.generator} />
		<link rel='icon' type='image/svg+xml' href='/favicon.png' />
		<script
			src='https://kit.fontawesome.com/bdaa21e6ed.js'
			is:inline
			crossorigin='anonymous'></script>
	</head>
	<body>
		<Navbar locale={locale} />
		<main class='container px-6 md:px-8 mt-14 flex flex-col gap-16'>
			<slot />
		</main>
		<Footer locale={locale} />
	</body>
	<script is:inline>
		console.log(
			`
   _____       __   __                      ______                
  / ____|     /_/  /_/                     |  ____|               
 | |     _ __ ___  ___   _ __   __ _ _ __  | |__   _ __  _______  
 | |    | '__/ _ \\/ _ \\ | '_ \\ / _\`|  '__| |  __| | '_ \\|_  / _ \\
 | |____| | |  __/  __/ | |_) | (_| | |    | |____| | | |/ / (_) |
  \\_____|_|  \\___|\\___| | .__/ \\__,_|_|    |______|_| |_/___\\___/ 
                        | |                                       
                        |_|                                       
		`
		);

		const getThemePreference = () => {
			if (
				typeof localStorage !== 'undefined' &&
				localStorage.getItem('theme')
			) {
				return localStorage.getItem('theme');
			}
			return window.matchMedia('(prefers-color-scheme: dark)').matches
				? 'dark'
				: 'light';
		};

		const isDark = getThemePreference() === 'dark';
		document.documentElement.classList[isDark ? 'add' : 'remove']('dark');

		if (typeof localStorage !== 'undefined') {
			const observer = new MutationObserver(() => {
				const isDark =
					document.documentElement.classList.contains('dark');
				localStorage.setItem('theme', isDark ? 'dark' : 'light');
			});
			observer.observe(document.documentElement, {
				attributes: true,
				attributeFilter: ['class'],
			});
		}
	</script>
</html>
