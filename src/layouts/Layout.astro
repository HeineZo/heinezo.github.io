---
import Navbar from '@/layouts/Navbar.astro';
import Footer from './Footer.astro';

interface Props {
	title: string;
}

const { title } = Astro.props;
---

<!doctype html>
<html lang='fr'>
	<head>
		<title>{title}</title>
		<meta charset='UTF-8' />
		<meta name='viewport' content='width=device-width' />
		<meta name="description" content="Passionné par les architectures et le code propre, je passe mon temps libre à construire des projets personnels qui me poussent à aller plus loin dans ma réflexion et mes compétences">
		<meta name="keywords" content="portfolio, développement fullstack, développement frontend, react, tailwind, vuejs, nextjs, notion, figma, alternance, vannes, projets, compétences">
		<meta name="author" content="Enzo Morvan">
		<meta property="og:title" content="Portfolio d'Enzo Morvan">
		<meta property="og:description" content="Passionné par les architectures et le code propre, je passe mon temps libre à construire des projets personnels qui me poussent à aller plus loin dans ma réflexion et mes compétences">
		<meta property="og:type" content="website">
		<meta property="og:url" content="https://heinezo.github.io">
		<meta property="og:image" content="/preview.jpg">
		<meta name="twitter:card" content="summary">
		<meta name="twitter:title" content="Portfolio d'Enzo Morvan">
		<meta name="twitter:description" content="Passionné par les architectures et le code propre, je passe mon temps libre à construire des projets personnels qui me poussent à aller plus loin dans ma réflexion et mes compétences">
		<meta name="twitter:image" content="/preview.jpg">
		<meta name='generator' content={Astro.generator} />
		<link rel='icon' type='image/svg+xml' href='/favicon.png' />
		<script
			src='https://kit.fontawesome.com/bdaa21e6ed.js'
			is:inline
			crossorigin='anonymous'></script>
	</head>
	<body>
		<Navbar />
		<main class='container px-6 md:px-8 mt-14 flex flex-col gap-16'>
			<slot />
		</main>
		<Footer />
	</body>
	<script is:inline>
		console.log(
			`
   _____       __   __                      ______                
  / ____|     /_/  /_/                     |  ____|               
 | |     _ __ ___  ___   _ __   __ _ _ __  | |__   _ __  _______  
 | |    | '__/ _ \\/ _ \\ | '_ \\ / _\`|  '__| |  __| | '_ \\|_  / _ \\
 | |____| | |  __/  __/ | |_) | (_| | |    | |____| | | |/ / (_) |
  \\_____|_|  \\___|\\___| | .__/ \\__,_|_|    |______|_| |_/___\\___/ 
                        | |                                       
                        |_|                                       
		`
		);

		const getThemePreference = () => {
			if (
				typeof localStorage !== 'undefined' &&
				localStorage.getItem('theme')
			) {
				return localStorage.getItem('theme');
			}
			return window.matchMedia('(prefers-color-scheme: dark)').matches
				? 'dark'
				: 'light';
		};

		const isDark = getThemePreference() === 'dark';
		document.documentElement.classList[isDark ? 'add' : 'remove']('dark');

		if (typeof localStorage !== 'undefined') {
			const observer = new MutationObserver(() => {
				const isDark =
					document.documentElement.classList.contains('dark');
				localStorage.setItem('theme', isDark ? 'dark' : 'light');
			});
			observer.observe(document.documentElement, {
				attributes: true,
				attributeFilter: ['class'],
			});
		}
	</script>
</html>
